# Contoh environment untuk pengembangan lokal.
# Salin ke .env dan isi nilainya. Jangan pernah menyimpan .env di repositori.

NODE_ENV=development

# Database
DATABASE_URL=postgres://sahabat:sahabat@127.0.0.1:5432/sahabat_umkm
DATABASE_POOL_MAX=10
# true memakai PostgreSQL tertanam untuk pengujian tanpa server eksternal
TEST_USE_PGLITE=true

# API
API_HOST=127.0.0.1
API_PORT=4000
# Rahasia penanda tangan cookie sesi. Buat nilai acak panjang minimal 32 byte.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ganti-dengan-rahasia-acak-yang-panjang

# Frontend
WEB_ORIGIN=http://localhost:3000
# Dipanggil dari peramban, jadi hostnya harus sama dengan WEB_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Email
EMAIL_PROVIDER=log
EMAIL_FROM=Sahabat UMKM <noreply@sahabatumkm.example>

# Kunci enkripsi rahasia MFA. Harus berbeda dari SESSION_SECRET, dan nilai
# pengembangan di atas hanya untuk mesin lokal.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_SECRET=
# Penagihan langganan (PRD 6.10). Pembayaran dan faktur hanya menyala kalau
# kunci server Midtrans, identitas penjual, dan tautan kebijakan pengembalian
# dana sudah diisi. Kunci client tidak dipakai: pembayaran memakai halaman
# Midtrans, bukan Snap yang tertanam di aplikasi.
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_EMAIL=
BILLING_SELLER_TAX_ID=
BILLING_SELLER_TIMEZONE=Asia/Jakarta
BILLING_REFUND_POLICY_URL=
# Pengembangan saja: tidak memanggil Midtrans, tetapi notifikasi pembayaran
# tetap diverifikasi. Diabaikan di produksi.
PAYMENT_SIMULATION=

# Penyimpanan objek, S3 kompatibel
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=
S3_BUCKET=sahabat-umkm
S3_ACCESS_KEY_ID=sahabat
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Direktori penyimpanan lokal untuk foto barang dan lampiran. Dipakai kalau S3
# kompatibel belum dijalankan. Jangan diisi di produksi: isinya tidak terenkripsi
# dan tidak punya salinan cadangan.
OBJECT_STORAGE_DIR=

# Pemantauan
SENTRY_DSN=
