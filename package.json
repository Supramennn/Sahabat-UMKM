{
  "name": "sahabat-umkm",
  "version": "0.0.0",
  "private": true,
  "description": "Aplikasi web untuk mencatat stok, mengelola pembelian, mencatat penjualan, dan membaca laporan usaha UMKM.",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --project postgres",
    "test:postgres:local": "tsx scripts/postgres-lokal.mts",
    "cadangkan": "tsx scripts/cadangkan.mts cadangkan",
    "uji-restore": "tsx scripts/cadangkan.mts uji",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "lint": "eslint .",
    "migrate": "npm run migrate --workspace packages/db",
    "db:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "test:contrast": "tsx scripts/check-ui-contrast.mts"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
